GATE_API_KEY=在这里填写你的Gate_API_Key
GATE_API_SECRET=在这里填写你的Gate_API_Secret

TRADING_PAIR=BTC_USDT
ORDER_USDT=20
MAX_POSITION_USDT=100
MAX_DAILY_LOSS_USDT=50
STOP_LOSS_PERCENT=0.02
TAKE_PROFIT_PERCENT=0.04
LOOP_SECONDS=300

# 默认安全模式：paper 不会调用下单接口
RUN_MODE=paper
LIVE_ARMED=false
LIVE_CONFIRMATION=

# 执行安全参数
ORDER_POLL_SECONDS=2
ORDER_TIMEOUT_SECONDS=30
MAX_SLIPPAGE_PERCENT=0.50
MAX_OPEN_ORDERS=1

# 数据源
DATA_TIMEOUT_SECONDS=10
NEWS_ENABLED=true
NEWS_MAX_ITEMS=20
MAX_QUOTE_AGE_SECONDS=30
MIN_MARKET_SOURCES=3
MIN_SIGNAL_CONFIDENCE=0.70
GATE_API_BASE_URL=https://api.gateio.ws
